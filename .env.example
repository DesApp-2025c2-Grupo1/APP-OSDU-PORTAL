# ─────────────────────────────────────────────────────────────────────────────
# Copiar este archivo como .env y completar los valores
# cp .env.example .env
# NUNCA commitear el .env real
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=portal_user
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_NAME=portal_prod

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_command_above

# ── Contraseña por defecto para nuevos usuarios ───────────────────────────────
# El admin deberá cambiarla en el primer login
DEFAULT_USER_PASSWORD=CHANGE_ME_temp_password

# ── SMTP (producción) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=CHANGE_ME_smtp_password
EMAIL_FROM=noreply@tu-dominio.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Separar múltiples orígenes con coma
ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# ── Dominio (usado por scripts de deploy y SSL) ───────────────────────────────
DOMAIN=tu-dominio.com

# ── pgAdmin (solo dev — no usar en producción) ────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_pgadmin_password

# ── Tags de imagen (para CI/CD) ───────────────────────────────────────────────
IMAGE_TAG=latest
