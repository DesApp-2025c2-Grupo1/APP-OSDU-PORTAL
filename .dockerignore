# Dependencias (se instalan dentro del contenedor)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Control de versiones
.git
.gitignore
.github

# Variables de entorno (se inyectan en runtime)
.env
.env.*
!.env.example

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Archivos de desarrollo y tests
src/test
coverage
*.test.js
jest.config.*

# Documentación y archivos de proyecto
*.md
README*
CHANGELOG*
EXAMPLE.md
scratch

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores e IDEs
.vscode
.idea
*.swp
*.swo
*~

# Logs
logs
*.log

# Uploads generados en runtime (se manejan con volumen)
public/uploads/*
!public/uploads/.gitkeep

# Build artifacts
dist
build

# Configuración de CI
.travis.yml
.circleci
